generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------- Auth --------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  // Fields required for a real-money launch, stubbed at MVP.
  cfHandle          String?   @unique
  cfHandleVerified  Boolean   @default(false)
  countryCode       String?   @db.VarChar(2)
  stateCode         String?
  dateOfBirth       DateTime?
  kycStatus         KycStatus @default(NONE)
  realMoneyEnabled  Boolean   @default(false)
  fingerprintHashes String[]  @default([])

  accounts Account[]
  sessions Session[]
  lineups  Lineup[]
  ledger   LedgerEntry[]

  @@index([email])
  @@index([cfHandle])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

// -------- Contests + lineups --------

model Contest {
  id                    String        @id @default(cuid())
  cfContestId           Int           @unique
  title                 String
  division              String?
  entryFeeCents         BigInt
  guaranteedPoolCents   BigInt        @default(0)
  prizeStructure        Json
  rulesVersion          Int           @default(1)
  status                ContestStatus @default(UPCOMING)
  startAt               DateTime
  lockAt                DateTime
  durationSecs          Int
  realMoneyEnabled      Boolean       @default(false)
  createdAt             DateTime      @default(now())
  finalisedAt           DateTime?

  lineups Lineup[]

  @@index([cfContestId])
  @@index([status])
  @@index([startAt])
}

enum ContestStatus {
  UPCOMING
  LOCKED
  LIVE
  PENDING_FINAL
  SETTLED
  CANCELLED
}

model Lineup {
  id                  String   @id @default(cuid())
  userId              String
  contestId           String
  entryFeeCents       BigInt
  entryTxnId          String   @unique
  captainHandle       String
  viceCaptainHandle   String
  handles             String[] // length TeamSize, includes captain + vice
  salaryUsed          Int
  rulesVersion        Int
  score               Float?
  rank                Int?
  payoutCents         BigInt?
  payoutTxnId         String?  @unique
  createdAt           DateTime @default(now())
  lockedAt            DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([contestId])
  @@index([userId])
  @@index([contestId, rank])
}

// -------- Ledger (double-entry, three-bucket) --------

model LedgerEntry {
  id             BigInt        @id @default(autoincrement())
  txnId          String        // UUID string, groups the 2+ sides
  accountId      String        // user id, or 'house'
  bucket         LedgerBucket
  amountCents    BigInt        // signed; sum per txnId MUST = 0
  reason         LedgerReason
  refType        String?
  refId          String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  user User? @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "LedgerEntry_user_fkey")

  @@index([txnId])
  @@index([accountId, bucket])
  @@index([createdAt])
}

enum LedgerBucket {
  deposit
  winning
  bonus
  house
}

enum LedgerReason {
  deposit
  withdrawal
  entry_fee
  payout
  rake
  refund
  bonus_grant
}

// Fast-read balance cache. Recomputable from LedgerEntry at any time.
model Balance {
  accountId   String
  bucket      LedgerBucket
  amountCents BigInt
  updatedAt   DateTime     @updatedAt

  @@id([accountId, bucket])
}
